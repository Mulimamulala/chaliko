RewriteEngine On
RewriteBase /

# Send old /index.html links straight to the root
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect any other visible .html request to its extension-less form (query string preserved)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve name.html when /name is requested, without changing the visible URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
