{
  "name": "chaliko",
  "compatibility_date": "2026-08-06",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "npm run build"
  },
  "vars": {
    "NOTIFY_FROM": "Chaliko Website <bookings@chaliko.com>",
    "NOTIFY_EMAILS": "chalikocarhire@yahoo.com,mulimamulala4@gmail.com"
  }
}
