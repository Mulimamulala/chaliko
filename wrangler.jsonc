{
  "name": "chaliko",
  "compatibility_date": "2026-08-06",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "npm run build"
  },
  // Per-IP limit for /api/mailer (see isRateLimited in src/worker.js):
  // 5 form submissions per 60 seconds from one IP.
  "ratelimits": [
    {
      "name": "MAILER_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "NOTIFY_FROM": "Chaliko Website <bookings@chaliko.com>",
    "NOTIFY_EMAILS": "chalikocarhire@yahoo.com"
  }
}
